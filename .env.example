# ─────────────────────────────────────────────────────────────────────────────
# Altrix Labs — AI-Powered Personal Health Copilot
# Environment Variables Template
#
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI / LLM Backend ─────────────────────────────────────────────────────────
# OpenAI or compatible API key (used for real AI Copilot responses)
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Optional: Custom LLM endpoint (e.g. Azure OpenAI, Ollama, etc.)
VITE_LLM_BASE_URL=https://api.openai.com/v1

# ── Healthcare Integrations ───────────────────────────────────────────────────
# Epic MyChart / FHIR R4 OAuth2 credentials
VITE_EPIC_CLIENT_ID=your_epic_client_id_here
VITE_EPIC_FHIR_BASE_URL=https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4

# ── Analytics (Optional) ─────────────────────────────────────────────────────
# Vercel Analytics or PostHog project key
VITE_ANALYTICS_KEY=your_analytics_key_here

# ── App Config ────────────────────────────────────────────────────────────────
VITE_APP_NAME=Altrix Labs Health Copilot
VITE_APP_ENV=development
